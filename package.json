{
  "name": "goat-assets-dubai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/admin-app",
    "apps/funnel-app"
  ],
  "scripts": {
    "dev": "concurrently -n funnel,admin -c blue,green \"npm:dev:funnel\" \"npm:dev:admin\"",
    "dev:admin": "npm run dev --workspace=admin-app",
    "dev:funnel": "npm run dev --workspace=funnel-app",
    "build:admin": "npm run build --workspace=admin-app",
    "build:funnel": "npm run build --workspace=funnel-app",
    "build": "npm run build --workspaces",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prisma": "^6.19.3"
  }
}
